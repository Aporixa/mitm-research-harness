# Copy to .env, fill in the credentials for the agents you will run, then:
#   chmod 600 .env
# docker/run.sh reads only these names from the file; anything else is ignored.
# .env is gitignored and dockerignored. Values are never printed or written to
# a capture; manifests record only which names were set.

# Anthropic: Claude Code (adapter claude-code)
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# OpenAI: Codex CLI (adapter codex)
# OPENAI_API_KEY=

# Google: Gemini CLI (adapter gemini-cli). Gemini API key...
# GEMINI_API_KEY=
# ...or Vertex AI:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
# GOOGLE_API_KEY=
